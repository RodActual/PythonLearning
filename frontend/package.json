{
  "name": "python-learning-ui-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "copy-pyodide": "node scripts/copy-pyodide.mjs",
    "predev": "npm run copy-pyodide",
    "dev": "vite",
    "prebuild": "npm run copy-pyodide",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:lessons": "python scripts/check_lessons.py",
    "test:e2e": "playwright test",
    "build:e2e": "npm run copy-pyodide && vite build --config vite.e2e.config.ts",
    "check": "npm run typecheck && npm run lint && npm run check:contrast && npm run check:lessons"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sentry/react": "^11.0.0",
    "firebase": "^12.19.0",
    "prismjs": "^1.30.0",
    "pyodide": "0.29.5",
    "react": "^19.3.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^18.2.0",
    "react-simple-code-editor": "^0.14.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.4",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": "22.x"
  }
}
